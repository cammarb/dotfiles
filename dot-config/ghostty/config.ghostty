font-family = JetBrains Mono
font-size = 10

cursor-style = block

theme = light:Nvim Light, dark:Nvim Dark
window-theme = ghostty

window-padding-x = 8
window-padding-y = 8

background-opacity = 0.9
background-blur = true

window-height = 32
window-width = 125

# This will only work in Linux
gtk-custom-css = ~/.config/ghostty/kde-style.css
